# Line-ending policy. Everything checks out as LF on every platform, so a
# Windows clone cannot rewrite text files to CRLF. Exact-byte content — test
# fixtures, lockfiles, generated artifacts — depends on this.
* text=auto eol=lf

# Binary — never convert
*.png binary
*.ico binary
*.woff2 binary
*.docx binary
*.xlsx binary
*.tgz binary
*.pdf binary
*.zip binary
